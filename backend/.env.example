# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────────
# Full connection string (takes priority over individual fields)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aidra

# Or individual fields
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=aidra
PG_USER=postgres
PG_PASSWORD=password
PG_SSL=false

# ── Firebase Admin SDK ───────────────────────────────────────
# Path to your service account key JSON downloaded from Firebase Console:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# OR set the JSON inline (useful for Docker / CI):
# FIREBASE_SERVICE_ACCOUNT_JSON={...}

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com

# ── Gemini triage (key stays server-side) ────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MODEL_VERSION=rules-v1
ALLOW_DEMO_AUTH=true
